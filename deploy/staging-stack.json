{
 "AWSTemplateFormatVersion":"2010-09-09",
 "Description":"Isolated BotInc v2 staging build and host. Does not modify v1 services or apex DNS.",
 "Parameters":{
  "VpcId":{"Type":"AWS::EC2::VPC::Id"},
  "SubnetId":{"Type":"AWS::EC2::Subnet::Id"},
  "Ami":{"Type":"AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>","Default":"/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"}
 },
 "Resources":{
  "Source":{"Type":"AWS::S3::Bucket","Properties":{"BucketEncryption":{"ServerSideEncryptionConfiguration":[{"ServerSideEncryptionByDefault":{"SSEAlgorithm":"AES256"}}]},"PublicAccessBlockConfiguration":{"BlockPublicAcls":true,"BlockPublicPolicy":true,"IgnorePublicAcls":true,"RestrictPublicBuckets":true},"VersioningConfiguration":{"Status":"Enabled"}}},
  "ServerImage":{"Type":"AWS::ECR::Repository","Properties":{"RepositoryName":"botinc-v2-staging/server","ImageScanningConfiguration":{"ScanOnPush":true},"ImageTagMutability":"IMMUTABLE"}},
  "WebImage":{"Type":"AWS::ECR::Repository","Properties":{"RepositoryName":"botinc-v2-staging/web","ImageScanningConfiguration":{"ScanOnPush":true},"ImageTagMutability":"IMMUTABLE"}},
  "BuildRole":{"Type":"AWS::IAM::Role","Properties":{"AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"codebuild.amazonaws.com"},"Action":"sts:AssumeRole"}]},"Policies":[{"PolicyName":"Build","PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":["s3:GetObject","s3:GetObjectVersion"],"Resource":{"Fn::Sub":"${Source.Arn}/*"}},{"Effect":"Allow","Action":"ecr:GetAuthorizationToken","Resource":"*"},{"Effect":"Allow","Action":["ecr:BatchCheckLayerAvailability","ecr:CompleteLayerUpload","ecr:UploadLayerPart","ecr:InitiateLayerUpload","ecr:PutImage","ecr:BatchGetImage","ecr:GetDownloadUrlForLayer"],"Resource":[{"Fn::GetAtt":["ServerImage","Arn"]},{"Fn::GetAtt":["WebImage","Arn"]}]},{"Effect":"Allow","Action":["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"],"Resource":{"Fn::Sub":"arn:aws:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/codebuild/botinc-v2-staging*"}}]}}]}},
  "Builder":{"Type":"AWS::CodeBuild::Project","Properties":{"Name":"botinc-v2-staging","ServiceRole":{"Fn::GetAtt":["BuildRole","Arn"]},"TimeoutInMinutes":30,"Artifacts":{"Type":"NO_ARTIFACTS"},"Source":{"Type":"S3","Location":{"Fn::Sub":"${Source}/source.zip"},"BuildSpec":"deploy/buildspec.yml"},"Environment":{"Type":"LINUX_CONTAINER","ComputeType":"BUILD_GENERAL1_MEDIUM","Image":"aws/codebuild/standard:7.0","PrivilegedMode":true,"EnvironmentVariables":[{"Name":"REGISTRY","Value":{"Fn::Sub":"${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com"}},{"Name":"IMAGE_TAG","Value":"unset"}]}}},
  "HostRole":{"Type":"AWS::IAM::Role","Properties":{"AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"ec2.amazonaws.com"},"Action":"sts:AssumeRole"}]},"ManagedPolicyArns":["arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"],"Policies":[{"PolicyName":"Deploy","PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":"ecr:GetAuthorizationToken","Resource":"*"},{"Effect":"Allow","Action":["ecr:BatchGetImage","ecr:GetDownloadUrlForLayer","ecr:BatchCheckLayerAvailability"],"Resource":[{"Fn::GetAtt":["ServerImage","Arn"]},{"Fn::GetAtt":["WebImage","Arn"]}]},{"Effect":"Allow","Action":"s3:GetObject","Resource":{"Fn::Sub":"${Source.Arn}/*"}},{"Effect":"Allow","Action":"secretsmanager:GetSecretValue","Resource":{"Fn::Sub":"arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:botinc-v2/staging-*"}}]}}]}},
  "Profile":{"Type":"AWS::IAM::InstanceProfile","Properties":{"Roles":[{"Ref":"HostRole"}]}},
  "Firewall":{"Type":"AWS::EC2::SecurityGroup","Properties":{"GroupDescription":"BotInc v2 HTTPS and ACME only","VpcId":{"Ref":"VpcId"},"SecurityGroupIngress":[{"IpProtocol":"tcp","FromPort":80,"ToPort":80,"CidrIp":"0.0.0.0/0"},{"IpProtocol":"tcp","FromPort":443,"ToPort":443,"CidrIp":"0.0.0.0/0"}]}},
  "Host":{"Type":"AWS::EC2::Instance","DeletionPolicy":"Retain","Properties":{"ImageId":{"Ref":"Ami"},"InstanceType":"t3.medium","SubnetId":{"Ref":"SubnetId"},"SecurityGroupIds":[{"Ref":"Firewall"}],"IamInstanceProfile":{"Ref":"Profile"},"MetadataOptions":{"HttpTokens":"required","HttpPutResponseHopLimit":1},"BlockDeviceMappings":[{"DeviceName":"/dev/xvda","Ebs":{"VolumeSize":60,"VolumeType":"gp3","Encrypted":true}}],"Tags":[{"Key":"Name","Value":"botinc-v2-staging"},{"Key":"Project","Value":"botinc-v2"}],"UserData":{"Fn::Base64":"#!/bin/bash\nset -euo pipefail\ndnf install -y docker\nsystemctl enable --now docker\nmkdir -p /opt/botinc-v2 /usr/local/lib/docker/cli-plugins\ncurl -fsSL https://github.com/docker/compose/releases/download/v2.39.4/docker-compose-linux-x86_64 -o /usr/local/lib/docker/cli-plugins/docker-compose\nchmod 755 /usr/local/lib/docker/cli-plugins/docker-compose\n"}}},
  "Address":{"Type":"AWS::EC2::EIP","Properties":{"Domain":"vpc","InstanceId":{"Ref":"Host"}}}
 },
 "Outputs":{"Bucket":{"Value":{"Ref":"Source"}},"InstanceId":{"Value":{"Ref":"Host"}},"PublicIP":{"Value":{"Ref":"Address"}},"ServerImage":{"Value":{"Fn::GetAtt":["ServerImage","RepositoryUri"]}},"WebImage":{"Value":{"Fn::GetAtt":["WebImage","RepositoryUri"]}}}
}
