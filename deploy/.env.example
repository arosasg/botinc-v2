# Copy to .env and fill in. Nothing here has a default that would be safe in
# production; the API refuses to start rather than guess.

POSTGRES_PASSWORD=
JWT_SECRET=
# openssl rand -hex 32
BOTINC_SECRETS_KEY=

FRONTEND_ORIGIN=https://test.botinc.ai
BOTINC_PUBLIC_API_URL=https://api.test.botinc.ai
COOKIE_DOMAIN=.botinc.ai

# Remote only. 'local' is refused when APP_ENV=production.
BOTINC_SANDBOX_PROVIDER=e2b
E2B_API_KEY=
BOTINC_E2B_TEMPLATE=

RESEND_API_KEY=
RESEND_FROM_EMAIL=BotInc <hello@botinc.ai>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.test.botinc.ai/api/auth/google/callback

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=

OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
